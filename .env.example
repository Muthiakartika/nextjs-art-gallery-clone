# Kredensial SMTP untuk form Contact Us (src/app/api/contact/route.ts).
# Salin file ini jadi ".env.local" lalu isi dengan kredensial email asli
# Anda (mis. dari Gmail App Password, provider SMTP seperti SendGrid,
# Mailgun, dsb). JANGAN commit ".env.local" — sudah di-gitignore.

# Contoh untuk Gmail: smtp.gmail.com, port 587, user = alamat Gmail,
# pass = App Password (bukan password akun biasa).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Alamat email tujuan yang akan menerima pesan dari form Contact Us.
CONTACT_TO_EMAIL=hello@satoriartgallery.com

# Cloudflare Turnstile (anti-bot check di form Contact Us) — ambil kedua
# key ini dari dashboard Cloudflare: Turnstile > Add Site.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY boleh terlihat publik (dipakai di client),
# TURNSTILE_SECRET_KEY WAJIB dirahasiakan (dipakai server untuk verifikasi).
# Selama dua variabel ini kosong, widget Turnstile tidak muncul dan form
# tetap bisa dipakai seperti biasa — baru aktif begitu diisi.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
