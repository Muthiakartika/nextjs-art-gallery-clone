# Kredensial SMTP untuk form Contact Us (src/app/api/contact/route.ts).
# Salin file ini jadi ".env.local" lalu isi dengan kredensial email asli
# Anda (mis. dari Gmail App Password, provider SMTP seperti SendGrid,
# Mailgun, dsb). JANGAN commit ".env.local" — sudah di-gitignore.

# Contoh untuk Gmail: smtp.gmail.com, port 587, user = alamat Gmail,
# pass = App Password (bukan password akun biasa).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Alamat email tujuan yang akan menerima pesan dari form Contact Us.
CONTACT_TO_EMAIL=hello@satoriartgallery.com
